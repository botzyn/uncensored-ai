# Uncensored AI Environment Variables
# Copy this to .env and fill in your values

# Groq API (free at groq.com) - Key NEVER exposed in code
GROQ_API=your_groq_api_key_here

# HuggingFace API (free at huggingface.co)
HUGGINGFACE_API=your_hf_key_here

# Stripe (for payments - optional)
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Server port (default: 3000)
PORT=3000
